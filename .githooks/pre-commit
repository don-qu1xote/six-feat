#!/bin/bash
set -e
set -u

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

missing() {
    echo "pre-commit: $1 не найден. Установи его:"
    echo "  macOS:   brew install clang-format && pipx install ruff && cd front && npm ci"
    echo "  Linux:   pip install clang-format==18.1.8 ruff && cd front && npm ci"
    exit 1
}

staged=$(git diff --cached --name-only --diff-filter=ACM || true)

if [ -z "$staged" ]; then
    exit 0
fi

fail=0

cpp_files=$(echo "$staged" | grep -E '\.(cpp|hpp)$' || true)
if [ -n "$cpp_files" ]; then
    command -v clang-format >/dev/null 2>&1 || missing clang-format
    for f in $cpp_files; do
        echo "pre-commit: форматирую $f"
        clang-format -i --style=file "$f"
    done
fi

py_files=$(echo "$staged" | grep -E '\.py$' || true)
if [ -n "$py_files" ]; then
    command -v ruff >/dev/null 2>&1 || missing ruff
    for f in $py_files; do
        echo "pre-commit: форматирую $f"
        ruff format "$f"
    done
fi

js_files=$(echo "$staged" | grep -E '^front/.*\.js$' || true)
if [ -n "$js_files" ]; then
    command -v npx >/dev/null 2>&1 || missing npx
    for f in $js_files; do
        echo "pre-commit: форматирую $f"
        (cd front && npx prettier --write "../$f" >/dev/null 2>&1)
    done
fi

echo "$staged" | xargs -r git add --

cpp_staged=$(echo "$staged" | grep -E '\.(cpp|hpp)$' || true)
if [ -n "$cpp_staged" ]; then
    command -v clang-format >/dev/null 2>&1 || missing clang-format
    if ! echo "$cpp_staged" | xargs clang-format --dry-run --Werror --style=file >/tmp/precommit-clang-format.log 2>&1; then
        echo "pre-commit: C++ не отформатирован (clang-format --dry-run --Werror):"
        cat /tmp/precommit-clang-format.log
        fail=1
    fi
fi

py_staged=$(echo "$staged" | grep -E '\.py$' || true)
if [ -n "$py_staged" ]; then
    command -v ruff >/dev/null 2>&1 || missing ruff
    if ! echo "$py_staged" | xargs ruff format --check >/tmp/precommit-ruff.log 2>&1; then
        echo "pre-commit: Python не отформатирован (ruff format --check):"
        tail -20 /tmp/precommit-ruff.log
        fail=1
    fi
fi

js_staged=$(echo "$staged" | grep -E '^front/.*\.js$' || true)
if [ -n "$js_staged" ] && [ -d front/node_modules ] && command -v npx >/dev/null 2>&1; then
    if ! echo "$js_staged" | while IFS= read -r file; do
        (cd front && npx prettier --check "../$file" >/dev/null 2>&1)
    done; then
        echo "pre-commit: JS не отформатирован (prettier --check):"
        tail -20 /tmp/precommit-prettier.log
        fail=1
    fi
fi

command -v python3 >/dev/null 2>&1 || missing python3
py_staged_for_comments=$(echo "$staged" | grep -E '\.py$' || true)
js_staged_for_comments=$(echo "$staged" | grep -E '\.(js|mjs|cjs)$' || true)
cpp_staged_for_comments=$(echo "$staged" | grep -E '\.(cpp|hpp|h|cc|cxx|c)$' || true)

if [ -n "$py_staged_for_comments" ] || [ -n "$js_staged_for_comments" ] || [ -n "$cpp_staged_for_comments" ]; then
    comment_targets=""
    for f in $py_staged_for_comments $js_staged_for_comments $cpp_staged_for_comments; do
        if [ -f "$f" ]; then
            comment_targets="$comment_targets $f"
        fi
    done
    if [ -n "$comment_targets" ]; then
        echo "pre-commit: проверяю комментарии (только build-необходимые, на русском)"
        if ! python3 scripts/check_comments.py $comment_targets >/tmp/precommit-comments.log 2>&1; then
            echo "pre-commit: найдены комментарии, не нужные для билда или не на русском:"
            cat /tmp/precommit-comments.log
            fail=1
        fi
    fi
fi

if [ -n "$py_staged" ]; then
    command -v ruff >/dev/null 2>&1 || missing ruff
    if ! echo "$py_staged" | xargs ruff check --select N >/tmp/precommit-ruff-naming.log 2>&1; then
        echo "pre-commit: нарушения правил именования Python (ruff N):"
        cat /tmp/precommit-ruff-naming.log
        fail=1
    fi
fi

js_eslint_files=$(echo "$staged" | grep -E '^front/src/.*\.js$' || true)
if [ -n "$js_eslint_files" ] && [ -d front/node_modules ] && command -v npx >/dev/null 2>&1; then
    if ! echo "$js_eslint_files" | xargs npx eslint >/tmp/precommit-eslint.log 2>&1; then
        echo "pre-commit: JS не проходит eslint (camelcase и др.):"
        tail -20 /tmp/precommit-eslint.log
        fail=1
    fi
fi

if [ "$fail" -ne 0 ]; then
    echo
    echo "Запусти 'make fmt' (форматирует всё) и закоммить результат."
    exit 1
fi

exit 0
