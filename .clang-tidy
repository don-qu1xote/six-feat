---
# Checks/WarningsAsErrors ниже НЕ те, что CI реально использует.
# .github/workflows/ci.yml передаёт собственные --checks/--warnings-as-errors
# в командной строке (--checks='-*,bugprone-*,performance-*,cppcoreguidelines-*',
# --warnings-as-errors='-*,bugprone-*,performance-*'), а значение --checks
# добавляется ПОСЛЕ списка Checks из этого файла и начинается с собственного
# `-*`, которое сбрасывает всё до него — так что список CI полностью
# заменяет этот; исключения cppcoreguidelines-avoid-magic-numbers/
# pro-bounds-pointer-arithmetic ниже НЕ применяются в CI (собственный список CI
# заново включает все cppcoreguidelines-*, без фильтрации), и CI clang-tidy
# job НЕ имеет continue-on-error — bugprone-*/performance-* находка роняет
# сборку. Этот файл управляет только голым `clang-tidy some_file.cpp` без
# флага --checks (интеграция с IDE, разработчик запускает напрямую) —
# держите примерно выровненным с набором CI, чтобы локальные запуски не были
# обманчиво тише, но не доверяйте ему предсказывать, что CI реально отловит.
Checks: >
  -*,
  bugprone-*,
  performance-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-non-private-member-variables-in-classes

WarningsAsErrors: ''
HeaderFilterRegex: '^(?!.*userver).*/src/.*'
FormatStyle: none
