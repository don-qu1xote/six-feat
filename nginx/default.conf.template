# Объединяет six-feat и six-feat-auth под одним публичным origin, чтобы
# относительные редиректы/запросы фронта (window.location.href = "/auth/login",
# GET /auth/me, POST /auth/logout — см. front/src/api/net.js и
# front/src/api/auth.js) попадали в правильный бэкенд, а не отдавали 404
# на том сервисе, который случайно раздаёт страницу.
#
# GENIUS_REDIRECT_URI обязан указывать сюда (публичный origin этого прокси),
# а не на собственный порт контейнера six-feat-auth — см. docker-compose.yml.
#
# Это шаблон, а не статичный конфиг: entrypoint официального nginx-образа
# прогоняет envsubst по всем файлам /etc/nginx/templates/*.template при
# старте контейнера и пишет результат в /etc/nginx/conf.d/<name> — подставляя
# ${SIX_FEAT_PORT} и т.п. из блока `environment:` сервиса nginx в
# docker-compose.yml, который в свою очередь дефолтится от тех же переменных
# SIX_FEAT_PORT/SIX_FEAT_AUTH_PORT/NGINX_PUBLIC_PORT, что используют сами
# сервисы six-feat/six-feat-auth — порт меняется в одном месте, а не
# хардкодится тут и молча расходится с реальным listener'ом приложения.
server {
    listen ${NGINX_PUBLIC_PORT};

    # Docker'овский встроенный DNS. Без него nginx резолвит имена upstream'ов
    # (six-feat, six-feat-auth, six-feat-game) ОДИН раз на старте и кэширует
    # IP навсегда: любой `docker compose up -d <service>`, пересоздающий
    # контейнер, даёт ему новый IP в сети, а nginx продолжает стучаться на
    # старый и отвечает 502 Bad Gateway, хотя сервис жив и healthy.
    # valid=10s заставляет перечитывать запись, а хранение адреса в
    # переменной ($auth_upstream и т.п. ниже) — резолвить её в рантайме на
    # каждый запрос, а не на этапе разбора конфига.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # [SF-PERF-04] Ответы /api/v1/graph (nodes + edges + per-edge
    # collaborations) на плотном сиде могут быть большими — сжимаем их на
    # слое прокси, а не учим каждый userver-хендлер делать это сам.
    # nginx:1.27-alpine (см. docker-compose.yml) несёт штатный gzip-модуль,
    # но не brotli (тот требует собранный вручную nginx с ngx_brotli), так
    # что здесь доступен именно gzip.
    #
    # gzip_proxied — критичная настройка именно для НАШЕЙ топологии: модуль
    # gzip в nginx по умолчанию НИКОГДА не сжимает проксированный ответ
    # (gzip_proxied off), если не сказать обратного — а graph_handler.cpp/
    # path_handler.cpp уже отдают "Cache-Control: private, must-revalidate"
    # на каждый ответ, и это ровно одно из условий, которые gzip_proxied
    # исключает по умолчанию. `any` разрешает сжатие проксированных ответов
    # безусловно, независимо от Cache-Control/Expires апстрима — здесь это
    # безопасно, потому что каждый location ниже проксирует только наши
    # собственные бэкенды six-feat/six-feat-auth, а не чужой контент с
    # неизвестной нам семантикой кэширования.
    #
    # gzip_vary добавляет "Vary: Accept-Encoding", чтобы любой кэш перед этим
    # сервером (браузер, CDN) учитывал её и не отдавал сжатое тело клиенту,
    # который его не запрашивал, и наоборот.
    #
    # gzip_min_length пропускает сжатие мелких тел (например, коротких
    # {"error":...} ответов этого хендлера), где стоимость CPU не окупается.
    #
    # ETag/304 не затрагиваются: If-None-Match/ETag — обычные заголовки,
    # которые nginx и так пробрасывает через proxy_pass в обе стороны
    # (proxy_hide_header мы не используем), а у 304 тела нет в принципе, так
    # что gzip'у его трогать нечего.
    gzip on;
    gzip_proxied any;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types application/json;

    location /auth/ {
        set $auth_upstream six-feat-auth;
        proxy_pass http://$auth_upstream:${SIX_FEAT_AUTH_PORT};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # sse_status_handler.cpp (GET /api/v1/status/stream?id=<artist_id>) — это
    # настоящий долгоживущий поток Server-Sent Events: HttpResponseBodyStream,
    # соединение держится открытым, чанк приходит каждые ~2с до конца
    # глубокого сканирования. Нужен отдельный location, матчащийся раньше
    # общего / ниже (nginx выбирает самый длинный совпадающий префикс), потому
    # что дефолты nginx для обычного запрос/ответа активно враждебны потоку:
    #   - proxy_buffering (по умолчанию on) заставляет nginx ждать, пока
    #     буфер заполнится или апстрим закроет соединение, и только потом
    #     слать что-то клиенту — для потока с чанками раз в ~2с, который
    #     законно может жить минуты, клиент не видит ничего до закрытия
    #     соединения, а EventSource трактует это как транспортную ошибку
    #     (onerror) и переподключается в ту же ловушку. Приложение уже шлёт
    #     X-Accel-Buffering: no (nginx учитывает его на каждый ответ), но
    #     proxy_buffering off здесь — тот же фикс, явно закреплённый в
    #     конфиге прокси, а не полагающийся на то, что апстрим вспомнит
    #     выставить этот заголовок на каждом пути кода.
    #   - proxy_read_timeout по умолчанию 60с: с запасом перекрывает 2с
    #     интервал опроса в штатном режиме, но без маржи на медленный цикл
    #     (GC/лок/затык БД) — один пропущенный бит убивает иначе здоровое
    #     соединение. Ставим щедро: открытое, но простаивающее SSE-соединение
    #     здесь ожидаемо, это не утечка.
    #   - proxy_http_version по умолчанию 1.0 для апстримного плеча, а 1.0 не
    #     поддерживает chunked transfer-encoding — nginx не может узнать, где
    #     кончается (бесконечный) ответ, кроме как по закрытию соединения
    #     апстримом, и в сочетании с маскирующим симптом буферизацией это
    #     усугубляет тот же режим «клиент не видит ничего до закрытия» с
    #     другого ракурса.
    location /api/v1/status/stream {
        set $stream_upstream six-feat;
        proxy_pass http://$stream_upstream:${SIX_FEAT_PORT};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        # [SF-PERF-04] Этот поток намеренно исключён из серверного gzip on
        # выше, явно: каждый чанк SSE — пара десятков байт JSON, всегда
        # заметно меньше gzip_min_length, так что он всё равно бы не
        # сжался — но явная запись здесь гарантирует, что так останется
        # даже если gzip_min_length потом уменьшат, а не тихо будет зависеть
        # от этого порога и для этого location.
        gzip off;
    }

    # [SF-GAME-10] Игровой сервис «соедини двух артистов» — challenge/
    # submit/leaderboard/profile — живёт в собственном отдельном контейнере
    # (тот же сплит, что и /auth/ выше), а не в наборе хендлеров six-feat.
    # Матчится раньше общего / ниже (nginx выбирает самый длинный
    # совпадающий префикс), чтобы /api/v1/game/* никогда не проваливался
    # в сам six-feat.
    location /api/v1/game/ {
        set $game_upstream six-feat-game;
        proxy_pass http://$game_upstream:${SIX_FEAT_GAME_PORT};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        set $app_upstream six-feat;
        proxy_pass http://$app_upstream:${SIX_FEAT_PORT};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
