+// Achievement rule-engine — [SF-GAME-19]
+// ════════════════════════════════════════════════════════════════════════════
+
+namespace {
+constexpr int kSpeedrunnerMaxElapsedMs = 15000;
+constexpr int kVeteranGames            = 50;
+constexpr int kEloMasterThreshold      = 1500;
