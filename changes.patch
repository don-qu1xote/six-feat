 .connect-leaderboard-title {
-  margin: 0 0 4px; font-size: var(--text-sm); font-weight: 700; color: var(--mist);
-  text-transform: uppercase; letter-spacing: 0.04em;
+  margin: 0 0 var(--space-2); font-family: var(--font-display); font-weight: 700; font-size: var(--text-sm);
 }
-.cl-row { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); }
+.cl-row { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-1) 0; font-size: var(--text-sm); }
 .cl-rank { width: 1.5em; color: var(--mist); font-weight: 600; }
 .cl-name { flex: 1; color: var(--paper); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
-.cl-score { color: var(--signal); font-weight: 700; }
-
-.connect-builder { display: flex; flex-direction: column; gap: var(--space-3); margin-top: auto; }
-.connect-actions { display: flex; gap: var(--space-2); }
-.connect-actions .ui-btn { flex: 1; }
+.cl-score { color: var(--signal); font-weight: 700; font-variant-numeric: tabular-nums; }
 
