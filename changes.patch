+.ch-av { width: 40px; height: 40px; }
+.ch-card-names { color: var(--paper); font-size: var(--text-sm); }
+.ch-card-names b { color: var(--paper); }
+.ch-card-meta { color: var(--mist); font-family: var(--font-mono); font-size: var(--text-xs); }
+.ch-more { display: block; margin: var(--space-5) auto 0; }
+
+/* ── Season & achievements ────────────────────────────────────────────────── */
+.sn-hero {
