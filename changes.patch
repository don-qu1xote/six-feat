diff --git a/front/src/styles/surfaces/game-screens.css b/front/src/styles/surfaces/game-screens.css
new file mode 100644
index 0000000..d3ce4ab
--- /dev/null
+++ b/front/src/styles/surfaces/game-screens.css
@@ -0,0 +1,343 @@
+/* ══════════════════════════════════════════════════════════════════════════
+   surfaces/game-screens.css — [design: routed game windows]
+
+   The game's routed sibling screens (Leaderboard, Profile, Challenges, Season)
+   and the shared game nav that sits atop every game surface — including the
+   Play surface (connect.css owns that one's inner split; the nav bar itself is
+   styled here so all five screens share one chrome). Same full-bleed overlay
+   posture as .connect-surface: absolute inset:0 above the graph, shown by a
+   `.show` class toggled from game-windows.js.
+
+   Fully token-driven (both themes fall out of tokens.css / the [data-theme]
+   overrides) and keyed to the same palette the graph page uses: signal =
+   start/you, pulse = goal, amber = season/trophy.
+   ══════════════════════════════════════════════════════════════════════════ */
+
+/* ── Shared game RAIL ─────────────────────────────────────────────────────────
+   [design: боковой рейл как на графе] The top nav bar is gone — every game
+   surface (Play + the four windows) now carries this vertical icon rail, the
+   same collapsed→hover-expand shape the Explorer's own `.rail` uses. Links keep
+   their `.game-nav-link[data-surface]` hooks so game-windows.js's active-state
+   marking works unchanged. */
+.game-rail {
+  flex: 0 0 62px;
+  width: 62px;
+  display: flex;
+  flex-direction: column;
+  align-items: stretch;
+  gap: 6px;
+  padding: var(--space-4) 9px;
+  border-right: 1px solid var(--line);
+  background: rgba(var(--panel-rgb), .72);
+  backdrop-filter: blur(10px);
+  overflow: hidden;
+  z-index: 6;
+  transition: width .18s ease;
+}
+.game-rail:hover { width: 210px; }
+.game-rail-brand {
+  display: flex; align-items: center; gap: 11px;
+  padding: 4px 9px var(--space-3); color: var(--paper);
+}
+.game-rail-brand .grl-ico { width: 22px; height: 22px; flex: 0 0 auto; color: var(--signal); }
+.game-rail-brand b {
+  font-family: var(--font-display); font-weight: 800; font-size: var(--text-base);
+  white-space: nowrap; opacity: 0; transition: opacity .15s ease;
+}
+.game-rail:hover .game-rail-brand b { opacity: 1; }
+.game-rail-link {
+  display: flex; align-items: center; gap: 12px; height: 44px; padding: 0 11px;
+  border: 1px solid transparent; border-radius: var(--r-sm);
+  color: var(--mist); text-decoration: none; white-space: nowrap;
+  position: relative; cursor: pointer;
+  transition: color .15s ease, background-color .15s ease, border-color .15s ease;
+}
+.game-rail-link .grl-ico { width: 20px; height: 20px; flex: 0 0 auto; }
+.game-rail-link .grl-lab { opacity: 0; transition: opacity .15s ease; font-weight: 600; font-size: var(--text-sm); }
+.game-rail:hover .grl-lab { opacity: 1; }
+.game-rail-link:hover { color: var(--paper); background: rgba(var(--line-rgb), .06); border-color: var(--line); }
+.game-nav-link.is-active { color: var(--paper); border-color: var(--signal); background: rgba(var(--signal-rgb), .13); }
+.game-nav-link.is-active .grl-ico { color: var(--signal); }
+.game-rail-spacer { flex: 1; }
+.game-rail-back:hover { color: var(--paper); border-color: var(--signal); }
+/* Collapsed-state tooltip (hidden once the rail is expanded on hover). */
+.game-rail-link[data-tip]::after {
+  content: attr(data-tip);
+  position: absolute; left: 52px; top: 50%; transform: translateY(-50%) translateX(-4px);
+  background: var(--panel-2); color: var(--paper); border: 1px solid var(--line);
+  border-radius: 8px; padding: 5px 9px; font-size: var(--text-xs); white-space: nowrap;
+  opacity: 0; pointer-events: none; box-shadow: var(--glass-glow); z-index: 20;
+  transition: opacity .12s ease, transform .12s ease;
+}
+.game-rail-link[data-tip]:hover::after { opacity: 1; transform: translateY(-50%); }
+.game-rail:hover .game-rail-link[data-tip]::after { display: none; }
+
+/* Play surface (connect.css owns its inner split) adopts the same rail-left
+   row layout — overrides connect.css's own `flex-direction: column`. */
+.connect-surface { flex-direction: row; }
+
+/* ── Screen shell ─────────────────────────────────────────────────────────── */
+.game-screen {
+  position: absolute;
+  inset: 0;
+  z-index: var(--z-surface, 20);
+  display: none;
+  flex-direction: row;
+  background: var(--ink);
+  background-image: radial-gradient(circle, rgba(var(--line-rgb), .5) 1px, transparent 1px);
+  background-size: 26px 26px;
+  overflow: hidden;
+}
+.game-screen.show { display: flex; }
+
+.game-screen-body {
+  flex: 1;
+  min-height: 0;
+  width: 100%;
+  max-width: 860px;
+  margin: 0 auto;
+  padding: var(--space-9) var(--space-8) var(--space-10);
+  overflow-y: auto;
+}
+.game-screen-body--wide { max-width: 1080px; }
+
+/* Section header + tabs (shared by Leaderboard / Challenges). */
+.gs-head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-4);
+  flex-wrap: wrap;
+  margin-bottom: var(--space-3);
+}
+.gs-title { font-family: var(--font-display); font-weight: 800; font-size: var(--text-2xl); color: var(--paper); }
+.gs-title--sm { font-size: var(--text-lg); }
+.gs-sub { color: var(--mist); font-size: var(--text-sm); margin-bottom: var(--space-4); }
+.gs-tabs { display: inline-flex; gap: 4px; padding: 4px; border-radius: var(--r-md); background: rgba(var(--panel-rgb), .7); border: 1px solid var(--line); }
+.gs-tab {
+  padding: 6px 14px;
+  border: 0;
+  border-radius: 999px;
+  background: transparent;
+  color: var(--mist);
+  font-size: var(--text-sm);
+  font-weight: 600;
+  cursor: pointer;
+  transition: color .16s ease, background-color .16s ease;
+}
+.gs-tab:hover { color: var(--paper); }
+.gs-tab.is-active { color: var(--ink); background: var(--signal); }
+.gs-empty { color: var(--mist); font-size: var(--text-sm); padding: var(--space-5) 0; text-align: center; }
+.gs-signin { display: inline-block; margin-top: var(--space-2); color: var(--signal); font-weight: 700; text-decoration: none; }
+.gs-signin:hover { text-decoration: underline; }
+
+/* Shared avatar (game-windows.js avatarHtml). */
+.gw-av { width: 34px; height: 34px; border-radius: 999px; object-fit: cover; flex: 0 0 auto; }
+.gw-av--fallback {
+  display: inline-flex; align-items: center; justify-content: center;
+  background: var(--panel-2); color: var(--signal);
+  border: 1px solid var(--line); font-weight: 700; font-size: var(--text-sm);
+}
+
+/* ── Leaderboard list (also reused by the season podium) ──────────────────── */
+.lb-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
+.lb-row {
+  display: grid;
+  grid-template-columns: 2rem 1fr auto auto;
+  align-items: center;
+  gap: var(--space-3);
+  padding: 10px var(--space-4);
+  border: 1px solid var(--line);
+  border-radius: var(--r-md);
+  background: rgba(var(--panel-rgb), .6);
+}
+.lb-rank { font-family: var(--font-mono); font-weight: 700; color: var(--mist); }
+.lb-row:nth-child(1) .lb-rank { color: var(--amber); }
+.lb-name { color: var(--paper); font-weight: 600; text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+a.lb-name:hover { color: var(--signal); }
+.lb-hops { color: var(--mist); font-size: var(--text-xs); }
+.lb-score { font-family: var(--font-mono); font-weight: 700; color: var(--signal); }
+
+/* ── Profile · personal cabinet (ЛК) ──────────────────────────────────────── */
+/* .pf-head / .pf-name / .pf-rank are also reused by the admin panel below. */
+.pf-head { display: flex; align-items: center; gap: var(--space-4); }
+.pf-rank { color: var(--mist); font-size: var(--text-sm); }
+
+.cab-hero {
+  display: grid; grid-template-columns: auto 1fr auto; gap: var(--space-6); align-items: center;
+  padding: var(--space-7);
+  border: 1px solid var(--line); border-radius: var(--r-lg);
+  background: rgba(var(--panel-rgb), .6); box-shadow: var(--glass-glow);
+  margin-bottom: var(--space-7);
+}
+.cab-avatar-ring {
+  width: 112px; height: 112px; border-radius: 50%; display: grid; place-items: center; flex: 0 0 auto;
+  background: conic-gradient(from 210deg, var(--signal), var(--pulse), var(--signal));
+}
+.pf-avatar {
+  width: 98px; height: 98px; border-radius: 50%; overflow: hidden;
+  display: inline-flex; align-items: center; justify-content: center;
+  background: var(--panel-2); color: var(--signal); border: 3px solid var(--panel);
+  font-family: var(--font-display); font-weight: 800; font-size: var(--text-2xl);
+}
+.pf-avatar img { width: 100%; height: 100%; object-fit: cover; }
+.cab-eyebrow { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: .16em; text-transform: uppercase; color: var(--signal); margin: 0; }
+.cab-name-row { display: flex; align-items: center; gap: var(--space-3); margin: var(--space-1) 0 var(--space-3); }
+.pf-name { font-family: var(--font-display); font-weight: 800; font-size: var(--text-3xl); color: var(--paper); margin: 0; letter-spacing: -.01em; }
+.cab-edit { width: 34px; height: 34px; border-radius: 9px; border: 1px solid var(--line); background: transparent; color: var(--mist); cursor: pointer; display: grid; place-items: center; flex: 0 0 auto; }
+.cab-edit:hover { color: var(--paper); border-color: var(--signal); }
+.cab-edit svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.6; }
+.cab-chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
+.cab-chip { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 999px; font-size: var(--text-xs); font-weight: 650; border: 1px solid var(--line); color: var(--mist); }
+.cab-chip--rank { background: rgba(var(--signal-rgb), .13); color: var(--signal); border-color: rgba(var(--signal-rgb), .4); }
+.cab-cta { display: flex; flex-direction: column; gap: var(--space-2); }
+
+.cab-tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); margin-bottom: var(--space-8); }
+.cab-tile { padding: var(--space-5); border: 1px solid var(--line); border-radius: var(--r-md); background: rgba(var(--panel-rgb), .6); }
+.cab-tile-v { display: block; font-family: var(--font-mono); font-weight: 800; font-size: var(--text-2xl); color: var(--paper); }
+.cab-tile-l { color: var(--mist); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: .07em; margin-top: var(--space-1); }
+
+.cab-section { margin-bottom: var(--space-8); }
+.cab-sec-title { font-family: var(--font-display); font-weight: 700; font-size: var(--text-lg); color: var(--paper); margin: 0 0 var(--space-4); }
+
+/* Achievements + history (populated by game-windows.js renderBadges/renderHistory). */
+.pf-badges { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: var(--space-3); }
+.pf-badge {
+  display: flex; flex-direction: column; gap: 3px;
+  padding: var(--space-4);
+  border: 1px solid var(--amber); border-radius: var(--r-md);
+  background: rgba(var(--amber-rgb), .09);
+}
+.pf-badge-title { color: var(--paper); font-weight: 700; font-size: var(--text-sm); }
+.pf-badge-descr { color: var(--mist); font-size: var(--text-xs); }
+.pf-history { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
+.pf-attempt {
+  display: grid; grid-template-columns: 4.5rem 1fr auto; align-items: center; gap: var(--space-4);
+  padding: var(--space-3) var(--space-4);
+  border: 1px solid var(--line); border-radius: var(--r-md);
+  background: rgba(var(--panel-rgb), .6);
+}
+.pf-attempt-score { font-family: var(--font-mono); font-weight: 700; font-size: var(--text-lg); }
+.pf-attempt--ok .pf-attempt-score { color: var(--signal); }
+.pf-attempt--bad .pf-attempt-score { color: var(--mist); }
+.pf-attempt-meta { color: var(--paper); font-size: var(--text-sm); }
+.pf-attempt-date { color: var(--mist); font-size: var(--text-xs); }
+
+/* ── Challenges browser ───────────────────────────────────────────────────── */
+.ch-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--space-3); }
+.ch-card {
+  display: flex; flex-direction: column; gap: var(--space-2);
+  padding: var(--space-4);
+  border: 1px solid var(--line); border-radius: var(--r-lg);
+  background: rgba(var(--panel-rgb), .7);
