+  font-size: var(--text-xs); font-weight: 600; color: var(--mist);
+  text-transform: uppercase; letter-spacing: .05em; padding: var(--space-1) 0;
+  transition: color var(--duration-base) var(--ease-standard);
+}
+.connect-browse-summary::-webkit-details-marker { display: none; }
+.connect-browse-chev { transition: transform var(--duration-base) var(--ease-standard); }
+.connect-browse[open] .connect-browse-chev { transform: rotate(90deg); }
+.connect-browse-summary:hover { color: var(--paper); }
+.connect-browse-chips {
+  display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3);
+  padding: var(--space-3); border: 1px dashed var(--line); border-radius: var(--r-md);
+}
+.connect-browse-loading,
+.connect-browse-empty { color: var(--mist); font-size: var(--text-sm); font-style: italic; margin: 0; }
+.cb-chip {
+  display: flex; align-items: center; gap: 7px;
+  padding: 4px 11px 4px 4px; border: 1px solid var(--line); border-radius: 999px;
+  font-size: var(--text-sm); font-weight: 600; color: var(--paper); background: var(--panel-2);
+  cursor: pointer; transition: border-color var(--duration-base) var(--ease-standard), background var(--duration-base) var(--ease-standard);
+}
+.cb-chip:hover { border-color: var(--amber); background: var(--hover-tint); }
+.cb-chip--goal { border-color: var(--pulse); color: var(--pulse); }
+.cb-chip--goal:hover { background: rgba(var(--pulse-rgb), .12); }
+.cb-avatar { width: 20px; height: 20px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
+.cb-avatar--fallback {
+  display: grid; place-items: center; background: var(--line); color: var(--ink);
+  font-size: 9px; font-weight: 800; font-family: var(--font-mono);
+}
+.cb-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 140px; }
+
+/* ── Leaderboard (inside the panel). ──────────────────────────────────── */
 .connect-leaderboard {
-  display: flex; flex-direction: column; gap: 4px;
-  padding: var(--space-3) var(--space-4);
-  border: 1px solid var(--line); border-radius: var(--r-md);
-  background: rgba(255, 255, 255, 0.02);
+  padding: var(--space-3); border: 1px solid var(--line); border-radius: var(--r-md); background: var(--panel-2);
 }
