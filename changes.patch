--- /dev/null
+++ b/front/src/styles/surfaces/connect.css
@@ -0,0 +1,112 @@
+/* ══════════════════════════════════════════════════════════════════════════
+   surfaces/connect.css — [SF-GAME-01] "Connect" game surface (#/game).
+   Split layout on the Observatory kit: a live chain-graph on the left, a
+   docked track panel on the right. Hidden until the router switches to the
+   game surface (connect.js toggles .show). Built on the existing design
+   tokens / ui-kit (ui-input, ui-btn), theme-aware via --ink/--paper.
+   ══════════════════════════════════════════════════════════════════════════ */
+
+.connect-surface {
+  position: absolute;
+  inset: 0;
+  z-index: var(--z-surface, 20);
+  display: none;
+  background: var(--ink);
+}
+.connect-surface.show { display: flex; }
+
+/* ── Left: chain-graph stage ─────────────────────────────────────────────── */
+.connect-stage {
+  position: relative;
+  flex: 1 1 auto;
+  min-width: 0;
+  overflow: hidden;
+  background:
+    radial-gradient(900px 520px at 30% -10%, color-mix(in srgb, var(--pulse) 12%, transparent), transparent 60%),
+    radial-gradient(circle, color-mix(in srgb, var(--paper) 4%, transparent) 1px, transparent 1px);
+  background-size: auto, 22px 22px;
+}
+.connect-stage canvas { display: block; width: 100%; height: 100%; }
+
+.connect-topline {
+  position: absolute;
+  top: 16px; left: 16px; right: 16px;
+  display: flex; align-items: center; gap: 14px;
+  pointer-events: none;
+}
+.connect-topline .connect-back { pointer-events: auto; }
+.connect-wordmark {
+  font-family: "Syne", var(--font-display, sans-serif);
+  font-weight: 800; font-size: 20px; letter-spacing: -.02em; color: var(--paper);
+  margin-left: auto;
+}
+.connect-wordmark .cw-dot { color: var(--signal); }
+
+/* ── Right: docked track panel ───────────────────────────────────────────── */
+.connect-dock {
+  flex: 0 0 clamp(320px, 32vw, 420px);
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-4);
+  padding: var(--space-6) var(--space-5);
+  overflow-y: auto;
+  background: linear-gradient(180deg, var(--panel), var(--panel-2));
+  border-left: 1px solid var(--line);
+  box-shadow: var(--shadow);
+}
+.connect-dock-head { display: flex; flex-direction: column; gap: 4px; }
+.connect-eyebrow {
+  font-size: var(--text-xs); font-weight: 700; letter-spacing: .14em;
+  text-transform: uppercase; color: var(--mist);
+}
+.connect-sub { font-size: var(--text-sm); color: var(--mist); margin: 0; }
+
+.connect-endpoints { display: flex; flex-direction: column; gap: var(--space-3); }
+.connect-field { position: relative; display: flex; flex-direction: column; gap: var(--space-1); }
+.connect-field--grow { flex: 1; }
+.connect-label {
+  font-size: var(--text-xs); font-weight: 500; color: var(--mist);
+  text-transform: uppercase; letter-spacing: .04em;
+}
+
+/* Chain as a track list */
+.connect-chain {
+  display: flex; flex-direction: column;
+  min-height: 60px;
+  padding: var(--space-2) var(--space-3);
+  border: 1px solid var(--line); border-radius: var(--r-md);
+  background: rgba(255, 255, 255, 0.02);
+}
+.connect-empty { color: var(--mist); font-size: var(--text-sm); margin: var(--space-2) 0; }
+.ct-row { position: relative; display: flex; align-items: center; gap: var(--space-3); padding: 7px 0; }
+.ct-row.ct-link::before {
+  content: ""; position: absolute; left: 15px; top: -9px; height: 18px; width: 2px; background: var(--line);
+}
+.ct-node {
+  width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0;
+  display: grid; place-items: center; font-size: 11px; font-weight: 800;
+  font-family: var(--font-mono, monospace);
+  color: var(--ink); background: transparent; border: 2px solid var(--line);
+}
+.ct-start .ct-node { border-color: var(--signal); color: var(--signal); }
+.ct-goal  .ct-node { border-color: var(--pulse);  color: var(--pulse); }
+.ct-hop   .ct-node { border-color: var(--amber);  color: var(--amber); }
+.ct-name { font-weight: 600; font-size: var(--text-sm); color: var(--paper); }
+.ct-tag {
+  font-size: 9.5px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase;
+  padding: 2px 7px; border-radius: 999px; border: 1px solid currentColor; margin-left: 8px; vertical-align: middle;
+}
+.ct-tag.ct-start { color: var(--signal); }
+.ct-tag.ct-goal  { color: var(--pulse); }
+
+.connect-status { font-size: var(--text-sm); color: var(--mist); margin: 0; min-height: 1.2em; }
+
+.connect-builder { display: flex; flex-direction: column; gap: var(--space-3); margin-top: auto; }
+.connect-actions { display: flex; gap: var(--space-2); }
+.connect-actions .ui-btn { flex: 1; }
+
+@media (max-width: 720px) {
+  .connect-surface.show { flex-direction: column; }
+  .connect-stage { flex: 0 0 40vh; }
+  .connect-dock { flex: 1 1 auto; border-left: none; border-top: 1px solid var(--line); }
+}
