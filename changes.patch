+}
+.sn-ach.is-earned { opacity: 1; border-color: var(--amber); background: rgba(var(--amber-rgb), .1); }
+.sn-ach-title { color: var(--paper); font-weight: 700; font-size: var(--text-sm); }
+.sn-ach-descr { color: var(--mist); font-size: var(--text-xs); }
+
+/* ── Admin panel (owner-only, embedded in Profile) ────────────────────────── */
+.admin-panel {
+  margin-top: var(--space-6);
