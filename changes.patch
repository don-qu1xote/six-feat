+.sn-progress-fill { display: block; height: 100%; width: 0; background: var(--amber); border-radius: 999px; transition: width .4s ease; }
+.sn-dates { color: var(--mist); font-size: var(--text-xs); }
+.sn-section { margin-bottom: var(--space-6); }
+.sn-link { color: var(--signal); font-size: var(--text-sm); font-weight: 600; text-decoration: none; }
+.sn-link:hover { text-decoration: underline; }
+.sn-ach-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: var(--space-3); }
