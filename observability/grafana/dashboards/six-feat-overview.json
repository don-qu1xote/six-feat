{
  "id": null,
  "uid": "six-feat-observability",
  "title": "six-feat — Observability overview",
  "description": "RED for six-feat's public API handlers, genius-gateway circuit-breaker/rate-lane state, enrichment queue depth. Data source: Prometheus, scraped from each service's internal monitor listener (see observability/prometheus/prometheus.yml).",
  "tags": ["six-feat", "SF-OBS-01"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "RED — six-feat public API handlers",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate (RPS) by handler",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "six-feat-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "six-feat-prometheus" },
          "expr": "sum by (http_path) (rate(http_handler_rps{job=\"six-feat\", http_path=~\"/api/v1/.*\"}[$__rate_interval]))",
          "legendFormat": "{{http_path}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error rate (5xx, %) by handler",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "six-feat-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "six-feat-prometheus" },
          "expr": "100 * sum by (http_path) (rate(http_handler_reply_codes{job=\"six-feat\", http_path=~\"/api/v1/.*\", http_code=~\"5..\"}[$__rate_interval])) / sum by (http_path) (rate(http_handler_rps{job=\"six-feat\", http_path=~\"/api/v1/.*\"}[$__rate_interval]))",
          "legendFormat": "{{http_path}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Duration p99 by handler",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "six-feat-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "six-feat-prometheus" },
          "expr": "max by (http_path) (http_handler_timings_1min_p99{job=\"six-feat\", http_path=~\"/api/v1/.*\"})",
          "legendFormat": "{{http_path}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "genius-gateway — circuit breaker / rate lanes",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Circuit breaker state (0=closed, 1=open, 2=half-open)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "six-feat-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 2,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 0 },
          "mappings": [
            { "type": "value", "options": {
              "0": { "text": "closed", "color": "green" },
              "1": { "text": "open", "color": "red" },
              "2": { "text": "half-open", "color": "yellow" }
            } }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "six-feat-prometheus" },
          "expr": "genius_gateway_circuit_breaker_state{job=\"six-feat-genius-gateway\"}",
          "legendFormat": "circuit breaker",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Rate-lane tokens available (FG/BG)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "six-feat-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "six-feat-prometheus" },
          "expr": "genius_gateway_lane_foreground_tokens_available{job=\"six-feat-genius-gateway\"}",
          "legendFormat": "foreground tokens",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "six-feat-prometheus" },
          "expr": "genius_gateway_lane_background_tokens_available{job=\"six-feat-genius-gateway\"}",
          "legendFormat": "background tokens",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Rate-lane concurrency slots available (FG/BG)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "six-feat-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "six-feat-prometheus" },
          "expr": "genius_gateway_lane_foreground_slots_available{job=\"six-feat-genius-gateway\"}",
          "legendFormat": "foreground slots",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "six-feat-prometheus" },
          "expr": "genius_gateway_lane_background_slots_available{job=\"six-feat-genius-gateway\"}",
          "legendFormat": "background slots",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "six-feat-enrichment — background queue",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Enrichment queue depth",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "six-feat-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "six-feat-prometheus" },
          "expr": "enrichment_worker_queue_size{job=\"six-feat-enrichment\"}",
          "legendFormat": "queue size",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Enrichment pending (in-flight) artists",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "six-feat-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "six-feat-prometheus" },
          "expr": "enrichment_worker_pending_count{job=\"six-feat-enrichment\"}",
          "legendFormat": "pending count",
          "refId": "A"
        }
      ]
    }
  ]
}