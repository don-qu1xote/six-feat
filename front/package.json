{
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --outfile=dist/script.js --format=iife --global-name=_app && esbuild src/styles/index.css --bundle --minify --outfile=dist/style.css && node scripts/hash-build.mjs",
    "build:css": "esbuild src/styles/index.css --bundle --minify --outfile=dist/style.css",
    "check-bundle-size": "node scripts/check-bundle-size.mjs",
    "watch": "esbuild src/main.js --bundle --outfile=dist/script.js --format=iife --global-name=_app --watch",
    "watch:css": "esbuild src/styles/index.css --bundle --outfile=dist/style.css --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src scripts",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "vitest": "^2.1.9",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^25.0.1",
    "eslint": "^9.15.0",
    "@eslint/js": "^9.15.0",
    "globals": "^15.12.0",
    "@playwright/test": "^1.48.0"
  }
}
