# ════════════════════════════════════════════════════════════════════════════
# .env.example — template for local development
#
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git — it contains secrets.
# ════════════════════════════════════════════════════════════════════════════
# ── Env-профиль (SF-CFG-01) ───────────────────────────────────────────────────
# Выбирает config/profiles/<name>.env, sourced каждым docker-entrypoint.sh —
# единственный place, где дефолты LOGGING_LEVEL/COOKIE_SECURE/
# DB_REPLICA_HOST различаются между dev/staging/prod. Один и тот же
# docker-compose.yml, одна команда `docker compose up` для всех трёх —
# меняется только эта переменная. См. docs/DEVELOPMENT.md «Env-профили».
ENV_PROFILE=dev
# ── OAuth 2.0 Genius API Credentials ─────────────────────────────────────────
# Register an app at https://genius.com/api-clients to get these.
# GENIUS_CLIENT_ID is not secret; GENIUS_CLIENT_SECRET MUST stay secret.
GENIUS_CLIENT_ID=your-client-id-here
GENIUS_CLIENT_SECRET=your-client-secret-here
# ── Session Encryption Key ─────────────────────────────────────────────────────
# Generate a fresh one with: openssl rand -hex 32
# 64 hex chars → 32-byte AES-256 key.
APP_SECRET=CHANGEME_generate_with_openssl_rand_hex_32
# ── Optional (have sensible defaults) ─────────────────────────────────────────
# Must EXACTLY match the Redirect URI registered on genius.com/api-clients.
# [IDEA-53] The OAuth flow (/auth/login|callback|logout|me) lives in the
# standalone six-feat-auth service, reached through the nginx reverse proxy
# on port 8080 (not six-feat-auth's own 8083) — docker-compose.yml applies
# this same value to both services, so point it at the proxy's public origin.
GENIUS_REDIRECT_URI=http://localhost:8080/auth/callback
# Set true in production (HTTPS) so cookies carry the Secure flag.
# Leave false for local HTTP dev.
COOKIE_SECURE=false
# ── PostgreSQL Connection ─────────────────────────────────────────────────────
# Consumed both by docker-compose's postgres service and by the app container,
# which combines them into a single DSN at boot (see docker-entrypoint.sh) —
# the assembled DSN is never written to a tracked file. Change DB_PASSWORD for
# anything beyond local dev.
DB_NAME=six_feat
DB_USER=six_feat
DB_PASSWORD=CHANGEME_use_a_real_password
# Optional (default to the docker-compose "postgres" service on 5432):
DB_HOST=postgres
DB_PORT=5432
# [SF-INF-02] Leave DB_REPLICA_HOST unset for the default profile (single
# Postgres instance). Set DB_REPLICA_HOST=postgres-replica only when running
# `docker compose --profile prod-like up` — that gives the userver Cluster a
# real streaming standby to classify as Slave for read isolation. See
# docs/DEVELOPMENT.md's "Postgres cluster topology".
DB_REPLICA_HOST=
DB_REPLICA_PORT=5432
# Credentials for the dedicated replication role postgres-replica streams as
# (prod-like profile only; harmless defaults otherwise — the role is created
# but never used unless postgres-replica actually starts).
DB_REPLICATOR_USER=replicator
DB_REPLICATOR_PASSWORD=replicator_dev_password
# ── [SF-INF-08] PostgreSQL backups ────────────────────────────────────────────
# Используется scripts/backup-postgres.sh за compose-профилем "backup".
# Реплика (выше) — не бэкап: DELETE/DROP приезжают туда мгновенно.
BACKUP_KEEP=7
BACKUP_SCHEDULE=0 3 * * *
BACKUP_HOST_DIR=./.backups
# ── Optional: S3-совместимое хранилище ──────────────────────────────────────
BACKUP_S3_URL=
BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ── Internal API secret (six-feat-enrichment) ─────────────────────────────────
# Shared between six-feat and six-feat-enrichment to authenticate the
# internal POST /internal/enqueue / GET /internal/status calls between them.
# Generate with: openssl rand -hex 32
ENRICHMENT_INTERNAL_SECRET=CHANGEME_generate_with_openssl_rand_hex_32
# Optional (defaults to the docker-compose "six-feat-enrichment" service on 8081):
ENRICHMENT_BASE_URL=http://six-feat-enrichment:8081
# [SF-SEC-01] AppSecretParityChecker's target — six-feat compares its own
# APP_SECRET fingerprint against six-feat-auth's over this URL, never the
# secret itself. Optional (defaults to the docker-compose "six-feat-auth"
# service on 8083):
AUTH_BASE_URL=http://six-feat-auth:8083
# ── Yandex Music Gateway ───────────────────────────────────────────────────────
# Один OAuth-токен Яндекс.Музыки на весь деплой (НЕ per-user) — питает только
# поиск/граф (YandexMusicSourceProvider), не вход в систему. Вход — только
# через Genius (см. GENIUS_CLIENT_ID/GENIUS_CLIENT_SECRET выше).
# Получить: https://oauth.yandex.ru/
YANDEX_SERVICE_TOKEN=
# ── Ports — single source of truth ────────────────────────────────────────────
# Every port number below is otherwise duplicated across docker-compose.yml
# (expose/ports/healthchecks/internal URLs), nginx/default.conf.template
# (envsubst'd from these same names) and each service's own static_config.yaml
# listener — these env vars are the one place to change any of them without
# hunting down every copy. NGINX_PUBLIC_PORT is the only one meant to be
# reached from outside docker (nginx is the single public entry point, see
# docker-compose.yml); the SIX_FEAT_*_PORT ones are internal compose-network
# ports (six-feat-auth's is also published directly for debugging).
NGINX_PUBLIC_PORT=8080
SIX_FEAT_PORT=8080
SIX_FEAT_AUTH_PORT=8083
SIX_FEAT_ENRICHMENT_PORT=8081
SIX_FEAT_GENIUS_GATEWAY_PORT=8082
SIX_FEAT_GAME_PORT=8084
# [admin] Owner allowlist for the game's admin panel (/api/v1/game/admin):
# comma-separated Genius usernames (or derived user_ids). Only these players
# see the admin controls in their Profile screen (publish a daily challenge on
# demand). Empty = nobody is an admin — the panel never appears.
GAME_ADMIN_GENIUS_IDS=
# Observability profile only (docker compose --profile observability up) —
# Prometheus/Grafana web UIs, published to the host for local viewing.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# SF-OBS-04: alertmanager web UI (alert status/silences), same profile.
ALERTMANAGER_PORT=9093
