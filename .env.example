# ════════════════════════════════════════════════════════════════════════════
# .env.example — шаблон для локальной разработки
#
# Скопируйте этот файл в .env и подставьте свои значения.
# НИКОГДА не коммитьте .env в git — там лежат секреты.
# ════════════════════════════════════════════════════════════════════════════
# ── Env-профиль (SF-CFG-01) ───────────────────────────────────────────────────
# Выбирает config/profiles/<name>.env, sourced каждым docker-entrypoint.sh —
# единственный place, где дефолты LOGGING_LEVEL/COOKIE_SECURE/
# DB_REPLICA_HOST различаются между dev/staging/prod. Один и тот же
# docker-compose.yml, одна команда `docker compose up` для всех трёх —
# меняется только эта переменная. См. docs/DEVELOPMENT.md «Env-профили».
ENV_PROFILE=dev
# [SF-INF-10] `make deploy-local` (полный стек на этой машине) требует НЕ-dev
# профиля — иначе проверялись бы dev-дефолты, а не боевая конфигурация. Либо
# поставьте здесь staging, либо запускайте как `ENV_PROFILE=staging make
# deploy-local`. Публичный туннель включается ТОЛЬКО из окружения
# (`PUBLIC_TUNNEL=cloudflared make deploy-local`) и намеренно НЕ читается из
# этого файла: открывать машину в интернет нужно осознанно, а не строчкой,
# которая когда-то сюда попала. См. docs/DEVELOPMENT.md «Как поднять у себя».
# ── OAuth 2.0 — учётка Genius API ──────────────────────────────────────────
# Зарегистрируйте приложение на https://genius.com/api-clients, чтобы получить
# эти значения. GENIUS_CLIENT_ID — не секрет; GENIUS_CLIENT_SECRET обязан
# оставаться секретом.
GENIUS_CLIENT_ID=your-client-id-here
GENIUS_CLIENT_SECRET=your-client-secret-here
# ── Ключ шифрования сессий ───────────────────────────────────────────────────
# Сгенерируйте новый: openssl rand -hex 32
# 64 hex-символа → 32-байтный AES-256 ключ.
APP_SECRET=CHANGEME_generate_with_openssl_rand_hex_32
# ── Опционально (есть разумные дефолты) ──────────────────────────────────────
# Должен ТОЧНО совпадать с Redirect URI, зарегистрированным на
# genius.com/api-clients.
# [IDEA-53] OAuth-флоу (/auth/login|callback|logout|me) живёт в отдельном
# сервисе six-feat-auth и доступен через nginx reverse proxy на порту 8080
# (а не через собственный 8083 six-feat-auth) — docker-compose.yml применяет
# это же значение к обоим сервисам, так что указывайте публичный origin прокси.
GENIUS_REDIRECT_URI=http://localhost:8080/auth/callback
# true в проде (HTTPS), чтобы cookie уносили Secure-флаг.
# false для локальной разработки по HTTP.
COOKIE_SECURE=false
# ── Подключение к PostgreSQL ─────────────────────────────────────────────────
# Потребляется и postgres-сервисом docker-compose, и контейнером приложения,
# который собирает из них единый DSN при старте (см. docker-entrypoint.sh) —
# собранный DSN никогда не пишется в отслеживаемый файл. Меняйте
# DB_PASSWORD, только если это не просто локальная разработка.
DB_NAME=six_feat
DB_USER=six_feat
DB_PASSWORD=CHANGEME_use_a_real_password
# Опционально (по умолчанию — сервис "postgres" из docker-compose на 5432):
DB_HOST=postgres
DB_PORT=5432
# [SF-INF-02] Для дефолтного профиля оставьте DB_REPLICA_HOST пустым (один
# инстанс Postgres). Ставьте DB_REPLICA_HOST=postgres-replica только при
# `docker compose --profile prod-like up` — тогда userver Cluster получит
# настоящий streaming standby и сможет классифицировать его как Slave для
# read-изоляции. См. «Postgres cluster topology» в docs/DEVELOPMENT.md.
DB_REPLICA_HOST=
DB_REPLICA_PORT=5432
# Учётка выделенной роли репликации, под которой postgres-replica стримит
# (только для prod-like профиля; в остальных случаях дефолты безвредны — роль
# создаётся, но не используется, пока postgres-replica реально не стартует).
DB_REPLICATOR_USER=replicator
DB_REPLICATOR_PASSWORD=replicator_dev_password
# ── [SF-INF-08] Бэкапы PostgreSQL ────────────────────────────────────────────
# Используется scripts/backup-postgres.sh за compose-профилем "backup".
# Реплика (выше) — не бэкап: DELETE/DROP приезжают туда мгновенно.
BACKUP_KEEP=7
BACKUP_SCHEDULE=0 3 * * *
BACKUP_HOST_DIR=./.backups
# ── Опционально: S3-совместимое хранилище ───────────────────────────────────
BACKUP_S3_URL=
BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ── Внутренний секрет API (six-feat-enrichment) ──────────────────────────────
# Общий для six-feat и six-feat-enrichment: аутентифицирует внутренние
# POST /internal/enqueue и GET /internal/status между ними.
# Сгенерировать: openssl rand -hex 32
ENRICHMENT_INTERNAL_SECRET=CHANGEME_generate_with_openssl_rand_hex_32
# Опционально (по умолчанию — сервис "six-feat-enrichment" из docker-compose
# на 8081):
ENRICHMENT_BASE_URL=http://six-feat-enrichment:8081
# [SF-SEC-01] Цель AppSecretParityChecker — six-feat сверяет по этому URL
# отпечаток своего APP_SECRET с отпечатком six-feat-auth, но никогда не
# передаёт сам секрет. Опционально (по умолчанию — сервис "six-feat-auth"
# из docker-compose на 8083):
AUTH_BASE_URL=http://six-feat-auth:8083
# ── Порты — единый источник правды ───────────────────────────────────────────
# Иначе каждый номер порта ниже продублирован в docker-compose.yml
# (expose/ports/healthchecks/internal URLs), nginx/default.conf.template
# (envsubst'ится из этих же имён) и в listener'ах static_config.yaml каждого
# сервиса — эти env-переменные единственное место, где порт меняется без
# охоты по всем копиям. NGINX_PUBLIC_PORT — единственный, кто рассчитан на
# доступ снаружи docker (nginx — единственная публичная точка входа, см.
# docker-compose.yml); SIX_FEAT_*_PORT — внутренние порты compose-сети
# (six-feat-auth также публикуется напрямую для отладки).
NGINX_PUBLIC_PORT=8080
SIX_FEAT_PORT=8080
SIX_FEAT_AUTH_PORT=8083
SIX_FEAT_ENRICHMENT_PORT=8081
SIX_FEAT_GENIUS_GATEWAY_PORT=8082
SIX_FEAT_GAME_PORT=8084
# [admin] Allowlist владельцев админки игры (/api/v1/game/admin):
# Genius-username'ы (или производные user_id) через запятую. Только эти
# игроки видят админ-управление в своём Profile-экране (публиковать дневной
# челлендж по требованию). Пусто = админов нет — панель не появляется вовсе.
GAME_ADMIN_GENIUS_IDS=
# Только для observability-профиля (docker compose --profile observability
# up) — веб-интерфейсы Prometheus/Grafana, опубликованные на хост для
# локального просмотра.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# SF-OBS-04: веб-интерфейс alertmanager (статусы алертов/тишины), тот же
# профиль.
ALERTMANAGER_PORT=9093
