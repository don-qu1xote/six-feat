# config/profiles/dev.env
#
# Источник дефолтов при ENV_PROFILE=dev (дефолт — см. docs/DEVELOPMENT.md
# «Env-профили»). Все значения совпадают с бывшими ${VAR:-default} в
# docker-entrypoint.sh, просто формализованы здесь.
#
# ${VAR:-default} (не VAR=default) — чтобы явное значение из
# docker-compose/.env/shell по-прежнему побеждало: профиль заполняет
# только то, что никто другой не задал.

# Debug демаскирует токены/URL с токенами в stderr — info тихий уровень
# для повседневной локальной разработки.
LOGGING_LEVEL="${LOGGING_LEVEL:-info}"

# Локальная HTTP-разработка — нет TLS-терминатора, Secure-флаг
# просто не даст cookie отправляться.
COOKIE_SECURE="${COOKIE_SECURE:-false}"

# Пусто — один инстанс Postgres (дефолтный профиль compose,
# без --profile prod-like). Указывание этого хоста на что-то без
# реальной реплики молча отключает Slave-пул (см. docs/DEVELOPMENT.md,
# «Postgres cluster topology»).
DB_REPLICA_HOST="${DB_REPLICA_HOST:-}"
