# Дефолты для ENV_PROFILE=dev (заполняют только незаданные переменные — ${VAR:-default})
LOGGING_LEVEL="${LOGGING_LEVEL:-info}"

# Без TLS-терминатора Secure-флаг не даст cookie отправляться
COOKIE_SECURE="${COOKIE_SECURE:-false}"

# Пусто — один инстанс Postgres (дефолтный compose-профиль)
DB_REPLICA_HOST="${DB_REPLICA_HOST:-}"
