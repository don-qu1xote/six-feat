# config/profiles/prod.env
#
# Источник дефолтов при ENV_PROFILE=prod (см. docs/DEVELOPMENT.md
# «Env-профили»).
#
# ${VAR:-default} — чтобы явное значение из .env/shell по-прежнему
# побеждало. См. dev.env про полную мотивацию и verify-env-profiles.py
# про то, что здесь запрещено (секреты, обязательные переменные).

# Тише dev/staging info — prod не должен эмитить ничего ниже warning
# по умолчанию. Debug здесь недопустим (см. dev.env: debug
# демаскирует токены/URL с токенами в stderr).
LOGGING_LEVEL="${LOGGING_LEVEL:-warning}"

# Перед services всегда стоит TLS-терминатор — cookie должны носить
# Secure-флаг, иначе браузер их не отправит.
COOKIE_SECURE="${COOKIE_SECURE:-true}"

# postgres-replica — настоящая streaming-реплика
# (docker compose --profile prod-like up) — реальная kMaster/kSlave
# изоляция вместо чтений через master. При развёртывании на внешнем
# кластере: переопределите DB_REPLICA_HOST в .env на реальный адрес
# standby — это значение — рабочий дефолт только для этого compose.yml.
DB_REPLICA_HOST="${DB_REPLICA_HOST:-postgres-replica}"
