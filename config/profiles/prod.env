# Дефолты для ENV_PROFILE=prod
LOGGING_LEVEL="${LOGGING_LEVEL:-warning}"

# TLS-терминатор всегда перед services — cookie только с Secure-флагом
COOKIE_SECURE="${COOKIE_SECURE:-true}"

# postgres-replica — реальная streaming-реплика (compose-профиль prod-like);
# для внешнего кластера переопределите DB_REPLICA_HOST в .env
DB_REPLICA_HOST="${DB_REPLICA_HOST:-postgres-replica}"
