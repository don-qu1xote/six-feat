# config/profiles/staging.env
#
# Источник дефолтов при ENV_PROFILE=staging (см. DEVELOPMENT.md
# «Env-профили»). Staging повторяет的安全 posture prod (HTTPS, Secure
# cookies) для реального тестирования сессий, но сохраняет уровень логов
# как в prod и, как и dev, обычно работает с одним инстансом Postgres
# (собственная реплика staging в этом репо не предполагается).
#
# ${VAR:-default} — чтобы явное значение из .env/shell по-прежнему
# побеждало. См. dev.env про полную мотивацию и verify-env-profiles.py
# про то, что здесь запрещено (секреты, обязательные переменные).

LOGGING_LEVEL="${LOGGING_LEVEL:-info}"

# Как и prod: перед services стоит TLS-терминатор, поэтому cookie
# должны носить Secure-флаг, иначе браузер их не отправит.
COOKIE_SECURE="${COOKIE_SECURE:-true}"

# Пусто по умолчанию — см. dev.env про этот же var. Задайте
# DB_REPLICA_HOST напрямую в .env для staging с реальной standby-
# репликой; этот профиль не подразумевает её наличие.
DB_REPLICA_HOST="${DB_REPLICA_HOST:-}"
