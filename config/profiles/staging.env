# Дефолты для ENV_PROFILE=staging: security posture как в prod, один инстанс Postgres
LOGGING_LEVEL="${LOGGING_LEVEL:-info}"

# Как и в prod: TLS-терминатор перед services, cookie — только с Secure-флагом
COOKIE_SECURE="${COOKIE_SECURE:-true}"

# Пусто по умолчанию; для staging с реальной репликой задайте DB_REPLICA_HOST в .env
DB_REPLICA_HOST="${DB_REPLICA_HOST:-}"
