# .dockerignore
# Держим build context маленьким и не даём секретам протечь в слои образов.

# Настоящие env-файлы демону не отдаём никогда
.env
*.env

# Локальные SQLite-данные (dev bind mount) — не должны попадать в build context
data/

# Каталоги данных Postgres (volumes из docker-compose.yml) — разрастаются до
# сотен МБ/ГБ; уже в gitignore, а .dockerignore о них забыл
.pgdata/
.pgdata-replica/

# Метаданные VCS — в build context не нужны
.git/

# Артефакты сборки
build/
.cache/

# Мусор редакторов / ОС
.DS_Store
.idea/
.vscode/
**/*.swp
**/*.swo
