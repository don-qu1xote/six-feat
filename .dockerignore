# .dockerignore
# Keep the build context small and prevent secrets from leaking into image layers.

# Never send real env files to the daemon
.env
*.env

# Local SQLite data (dev bind mount) — never ship into the build context
data/

# Postgres bind-mount data dirs (docker-compose.yml volumes) — grow to
# hundreds of MB/GB over time; already gitignored, .dockerignore forgot them
.pgdata/
.pgdata-replica/

# VCS metadata — never needed in the build context
.git/

# Build artifacts
build/
.cache/

# Editor / OS noise
.DS_Store
.idea/
.vscode/
**/*.swp
**/*.swo